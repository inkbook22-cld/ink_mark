{
  "name": "ink-mark",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "INK 마케팅 스튜디오 — 블로그·인스타 콘텐츠 제작",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "verify:providers": "node scripts/verify-providers.mjs",
    "render:card": "node scripts/render-card.mjs",
    "naver:draft": "node scripts/naver-draft.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:typing": "node scripts/test-naver-typing.mjs",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:ui && electron .",
    "smoke": "node scripts/smoke-app.mjs"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "main": "electron/main.mjs"
}
